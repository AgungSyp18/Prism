# Supabase PostgreSQL Connection String
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Secret key used for signing session JWTs
JWT_SECRET="super-secret-jwt-key-lab-inventory-2026-min-32-chars"

# Default Demo Account Credentials
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_STAFF_USERNAME="staff"
DEMO_STAFF_PASSWORD="staff123"
